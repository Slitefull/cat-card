# Copy to .env (or .env.local) and fill in. Restart the dev server after changes.
#
# VITE_* values are baked into the client bundle at build time and are PUBLIC.
# Never put secrets (API keys, tokens) here.

# Backend base URL, e.g. https://api.example.com or /api (same-origin / dev proxy).
# Leave empty to use the built-in mock cat from src/api.ts.
# Expected endpoint: GET {VITE_API_URL}/cats/:id -> { id, name, breed, image }
VITE_API_URL=
